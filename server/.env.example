# Prisma connection string. The client is generated with --data-proxy, so this
# must use the prisma:// or prisma+postgres:// protocol, not postgresql://.
# Get one from https://console.prisma.io (Accelerate) pointed at your Postgres.
DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=your_key_here

# Port for local development. Vercel sets this itself in production.
PORT=8000
